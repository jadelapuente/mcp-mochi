{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jadelapuente/mcp-mochi",
  "description": "MCP server for Mochi flashcard integration.",
  "repository": {
    "url": "https://github.com/jadelapuente/mcp-mochi",
    "source": "github"
  },
  "version": "2.8.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@jadelapuente/mcp-mochi",
      "version": "2.8.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MOCHI_API_KEY",
          "description": "Your Mochi API key.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
